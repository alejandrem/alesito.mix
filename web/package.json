    "test:all": "npm test && npm run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
