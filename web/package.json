{
  "name": "alesito-mix-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --test tests/dashboard.test.js tests/midi.test.js",
